{
  "name": "dot-globe-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.16.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "pnpm --filter @hmwcs/dot-globe build && pnpm --filter dot-globe-example build",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm verify:geodata && pnpm build && pnpm verify:package && pnpm verify:notices",
    "dev": "pnpm --filter dot-globe-example dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate:geodata": "node scripts/geodata/generate-land-mask.mjs",
    "lint": "eslint .",
    "test": "pnpm --filter @hmwcs/dot-globe test",
    "typecheck": "pnpm -r typecheck",
    "verify:notices": "pnpm --filter dot-globe-example verify:notices",
    "verify:package": "pnpm verify:package-types && pnpm --filter dot-globe-example exec node scripts/package-smoke.mjs",
    "verify:package-types": "tsc -p scripts/package-smoke/tsconfig.json",
    "verify:geodata": "node scripts/geodata/verify-land-mask.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/three": "0.185.4",
    "@vitejs/plugin-react": "6.0.5",
    "d3-geo": "3.1.1",
    "eslint": "10.8.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.9.0",
    "prettier": "3.9.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "6.0.3",
    "typescript-eslint": "8.66.0",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  }
}
